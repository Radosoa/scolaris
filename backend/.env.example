# =====================================================================
#  Scolaris — API Laravel
#  Copier ce fichier en `.env` puis lancer `php artisan key:generate`.
# =====================================================================

# --- Application -------------------------------------------------------
APP_NAME=Scolaris
# local | production
APP_ENV=local
# Généré par `php artisan key:generate` (obligatoire en production aussi)
APP_KEY=
# Toujours `false` en production
APP_DEBUG=true
# URL publique de l'API (ex. https://scolaris-api.onrender.com)
APP_URL=http://localhost:8000

APP_LOCALE=fr
APP_FALLBACK_LOCALE=en
APP_FAKER_LOCALE=fr_FR
APP_TIMEZONE=Europe/Paris

# --- Frontend / CORS ----------------------------------------------------
# Origine(s) autorisée(s) à appeler l'API, séparées par des virgules.
# Ex. production : https://scolaris.vercel.app
FRONTEND_URL=http://localhost:5173

# --- Base de données MySQL ------------------------------------------------
# En local via docker compose : DB_HOST=mysql, DB_PORT=3306
# Depuis l'hôte Windows : DB_HOST=127.0.0.1, DB_PORT=3307
DB_CONNECTION=mysql
DB_HOST=mysql
DB_PORT=3306
DB_DATABASE=scolaris
DB_USERNAME=scolaris
DB_PASSWORD=secret

# --- Authentification (Sanctum en mode token Bearer) ----------------------
# Durée de vie des tokens en minutes (vide = pas d'expiration)
SANCTUM_TOKEN_EXPIRATION=720

# --- Files d'attente ------------------------------------------------------
# `database` : jobs stockés en base, traités par `php artisan queue:work`
# `sync`     : jobs exécutés immédiatement (hébergement gratuit sans worker)
QUEUE_CONNECTION=database

# --- Cache / sessions (l'API est stateless, la session ne sert qu'au web) --
CACHE_STORE=database
SESSION_DRIVER=array

# --- Fichiers (photos, PDF) -----------------------------------------------
FILESYSTEM_DISK=local

# --- Journalisation -------------------------------------------------------
LOG_CHANNEL=stack
LOG_STACK=single
LOG_LEVEL=debug

BCRYPT_ROUNDS=12
BROADCAST_CONNECTION=log
MAIL_MAILER=log
MAIL_FROM_ADDRESS="no-reply@scolaris.test"
MAIL_FROM_NAME="${APP_NAME}"
