# =====================================================================
#  Scolaris — API Laravel
#  Copier ce fichier en `.env` puis lancer `php artisan key:generate`.
# =====================================================================

# --- Application -------------------------------------------------------
APP_NAME=Scolaris
# local | production
APP_ENV=local
# Généré par `php artisan key:generate` (obligatoire en production aussi)
APP_KEY=
# Toujours `false` en production
APP_DEBUG=true
# URL publique de l'API (ex. https://scolaris-api.onrender.com)
APP_URL=http://localhost:8001

APP_LOCALE=fr
APP_FALLBACK_LOCALE=en
APP_FAKER_LOCALE=fr_FR
APP_TIMEZONE=Europe/Paris

# --- Frontend / CORS ----------------------------------------------------
# Origine(s) autorisée(s) à appeler l'API, séparées par des virgules.
# Ex. production : https://scolaris.vercel.app
FRONTEND_URL=http://localhost:5173

# --- Base de données MySQL ------------------------------------------------
# En local via docker compose : DB_HOST=mysql, DB_PORT=3306
# Depuis l'hôte Windows : DB_HOST=127.0.0.1, DB_PORT=3307
DB_CONNECTION=mysql
DB_HOST=mysql
DB_PORT=3306
DB_DATABASE=scolaris
DB_USERNAME=scolaris
DB_PASSWORD=secret

# --- Authentification (Sanctum en mode token Bearer) ----------------------
# Durée de vie des tokens en minutes (vide = pas d'expiration)
SANCTUM_TOKEN_EXPIRATION=720

# --- Files d'attente ------------------------------------------------------
# `database` : jobs stockés en base, traités par `php artisan queue:work`
#              (en local : service `worker` du docker-compose)
# `sync`     : jobs exécutés immédiatement (hébergement gratuit sans worker) ;
#              la génération des PDF d'une classe se fait alors dans la requête
QUEUE_CONNECTION=database

# --- Établissement (en-tête des bulletins et reçus PDF) --------------------
ECOLE_NOM="Collège Jean Moulin"
ECOLE_ADRESSE="12 rue des Écoles, 69003 Lyon"
ECOLE_TELEPHONE="04 78 00 00 00"
ECOLE_EMAIL=secretariat@college-jean-moulin.test
ECOLE_VILLE=Lyon
ECOLE_CHEF_ETABLISSEMENT="Le Principal"
# Devise par défaut (modifiable ensuite dans Paramètres) : MGA, EUR, USD, XOF…
ECOLE_DEVISE=EUR

# --- Bulletins ------------------------------------------------------------
# Pondération de la moyenne par matière (total = 1), voir config/bulletin.php
BULLETIN_POIDS_CONTROLE_CONTINU=0.4
BULLETIN_POIDS_COMPOSITION=0.6

# --- Cache / sessions (l'API est stateless, la session ne sert qu'au web) --
CACHE_STORE=database
SESSION_DRIVER=array

# --- Fichiers (photos, PDF) -----------------------------------------------
FILESYSTEM_DISK=local

# --- Journalisation -------------------------------------------------------
LOG_CHANNEL=stack
LOG_STACK=single
LOG_LEVEL=debug

BCRYPT_ROUNDS=12
BROADCAST_CONNECTION=log
MAIL_MAILER=log
MAIL_FROM_ADDRESS="no-reply@scolaris.test"
MAIL_FROM_NAME="${APP_NAME}"
