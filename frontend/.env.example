# URL de l'API Laravel, sans /api à la fin
# Production : https://scolaris-api.onrender.com (exemple)
VITE_API_URL=http://localhost:8001

# Afficher les boutons « comptes de démonstration » sur la page de connexion
VITE_SHOW_DEMO_ACCOUNTS=true

# Domaine dont les sous-domaines désignent les écoles (lycee-x.scolaris.mg) ; vide = code saisi à la connexion
VITE_DOMAINE_ECOLES=
